# Cloudflare Pages cache rules.

# GLBs and textures under assets/ are content-stable: a changed model ships
# under a new deploy, and index.html is never cached, so `immutable` is safe.
# Pages `/assets/*` only matches ONE path segment, so nested globs are needed.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*/*/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*/*/*/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=300, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/play*
  Cache-Control: no-cache, must-revalidate
